# Untuk deploy dengan Docker: salin ke .env (di folder ini) lalu isi.
# Jangan commit file .env. Untuk development tanpa Docker, lihat backend/.env.example.

# Password user MySQL "selaras" (dipakai aplikasi) dan password root MySQL.
# Buat masing-masing dengan: openssl rand -hex 24
# Keduanya dipakai saat database PERTAMA KALI dibuat; mengubahnya di sini
# setelah itu tidak mengubah password di MySQL.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Wajib, minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# Alamat di homeserver tempat aplikasi bisa dijangkau.
# 127.0.0.1:8080 = hanya dari homeserver itu sendiri (cloudflared / reverse proxy).
APP_BIND=127.0.0.1:8080

# Isi CF-Connecting-IP bila lewat Cloudflare Tunnel. Kosongkan bila diakses langsung.
# Hanya aman selama port aplikasi tidak bisa dijangkau langsung dari luar.
PROXY_HEADER=

# Biarkan kosong di homeserver (cookie Secure + HSTS, wajib HTTPS).
# Isi "development" HANYA untuk mencoba lewat http:// di jaringan lokal.
APP_ENV=

# Versi image MySQL (8.0.17 ke atas; MariaDB tidak didukung).
MYSQL_VERSION=8.4
