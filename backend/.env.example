# Salin ke .env lalu isi. Jangan commit file .env.

# development: cookie tanpa Secure (http://localhost). Kosongkan di homeserver.
APP_ENV=development

# Alamat server. Default hanya localhost; akses dari luar lewat Cloudflare Tunnel.
APP_ADDR=127.0.0.1:8080

DATABASE_URL=postgres://selaras:ganti-password@127.0.0.1:5432/selaras?sslmode=disable

# Wajib, minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# Folder hasil `npm run build`. Kosongkan saat development (pakai Vite dev server).
STATIC_DIR=

# Isi CF-Connecting-IP bila lewat Cloudflare Tunnel. Kosongkan bila server diakses langsung.
PROXY_HEADER=
